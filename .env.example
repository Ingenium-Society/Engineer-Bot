# The translator. Any OpenAI-compatible /chat/completions endpoint works.
#
#   DeepSeek     https://api.deepseek.com        deepseek-flash      (key required)
#   Groq         https://api.groq.com/openai/v1  openai/gpt-oss-20b  (key required, gsk_...)
#   OrcaRouter   https://api.orcarouter.ai/v1    deepseek/deepseek-v4-flash-free  (key required)
#   OpenAI       https://api.openai.com/v1       gpt-4o-mini         (key required)
#   Ollama       http://127.0.0.1:11434/v1       llama3.1:8b         (no key)
#   llama.cpp    http://127.0.0.1:8080/v1        the served name     (no key)
#   LM Studio    http://127.0.0.1:1234/v1        the loaded name     (no key)
#   vLLM         http://127.0.0.1:8000/v1        the served name     (no key)
#
# A loopback or private address needs no key. A public host without a key
# counts as "not configured" and the keyword parser answers instead.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_JSON_MODE=true
AI_TIMEOUT_SECONDS=3

ADMIN_PIN=1234
MAX_INSTRUCTIONS=14
TURN_SECONDS=20
PLAY_SECONDS=330
FILTER_SECONDS=10

# Speech: browser (Web Speech API) | server (faster-whisper) | off
STT_MODE=server
STT_LANG=id-ID
WHISPER_MODEL=base

# Networking. Leave PUBLIC_URL empty for LAN mode: the team laptops use this
# machine's IP over your own certificate.
#
# Set it to a tunnel URL to put the team pages behind cloudflared or ngrok:
#   cloudflared tunnel --url http://localhost:8000
#   PUBLIC_URL=https://<the-random-url-it-prints>
# In tunnel mode HTTPS_CERT/HTTPS_KEY are ignored and the tunnel terminates TLS.
PUBLIC_URL=

# LAN mode only: set both to serve TLS. The microphone needs a secure origin.
HTTPS_CERT=
HTTPS_KEY=
